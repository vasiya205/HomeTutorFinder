# =============================================================================
# Home Tutor Finder - configuration (copy to .env and fill in)
# Format: KEY=value   (no quotes, no spaces around =)
# =============================================================================

# ---- PostgreSQL (the password you chose when installing PostgreSQL / pgAdmin) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Databases hometutor_auth, hometutor_tutor, hometutor_booking and hometutor_notification
# are created automatically on first start. Set to false if your DB user cannot create databases.
DB_AUTO_CREATE=true
# Inserts demo tutors, students, bookings and reviews into EMPTY databases (password Demo@123).
SEED_DEMO_DATA=true

# ---- JWT (must be the same for every service; any long random text) ----
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_HOURS=10

# ---- Email notifications (Gmail SMTP) ----
# 1. Turn on 2-Step Verification for your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Put your Gmail address and the 16-character app password below.
# Leave empty to run without SMTP: emails are still saved and shown in the app (Inbox / Admin > Email log).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Home Tutor Finder

# ---- Payments (Razorpay TEST mode) ----
# Get free test keys: https://dashboard.razorpay.com -> Test Mode -> Account & Settings -> API Keys
# Leave empty to use the built-in demo checkout. Only rzp_test_ keys are accepted.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# AUTO = Razorpay when keys are set, otherwise demo | DEMO | RAZORPAY
PAYMENT_MODE=AUTO

# ---- URLs ----
# Used for links inside emails (password reset, dashboard buttons)
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed to call the API gateway (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
