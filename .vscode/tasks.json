{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build backend",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-backend.ps1"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "scripts/build-backend.sh"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "scripts/build-backend.sh"
        ]
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Run eureka-server",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run-service.ps1",
        "-Service",
        "eureka-server"
      ],
      "linux": {
        "command": "java",
        "args": [
          "-Xmx384m",
          "-jar",
          "backend/eureka-server/target/eureka-server-1.0.0.jar"
        ]
      },
      "osx": {
        "command": "java",
        "args": [
          "-Xmx384m",
          "-jar",
          "backend/eureka-server/target/eureka-server-1.0.0.jar"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "spring-boot",
        "pattern": {
          "regexp": "^\\s*__no_problem_pattern__$"
        },
        "background": {
          "activeBegin": true,
          "beginsPattern": "Starting \\w+Application|:: Spring Boot ::",
          "endsPattern": "Started \\w+Application in|APPLICATION FAILED TO START"
        }
      },
      "presentation": {
        "group": "backend",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
