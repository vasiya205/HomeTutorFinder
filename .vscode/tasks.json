    {
      "label": "Run frontend",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run-frontend.ps1"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "-c",
          "cd frontend && ([ -d node_modules ] || npm install) && npm run dev"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "-c",
          "cd frontend && ([ -d node_modules ] || npm install) && npm run dev"
        ]
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^\\s*__no_problem_pattern__$"
        },
        "background": {
          "activeBegin": true,
          "beginsPattern": "vite|npm",
          "endsPattern": "Local:|ready in"
        }
      },
      "presentation": {
        "group": "frontend",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run all services",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Run eureka-server",
        "Run auth-service",
        "Run tutor-service",
        "Run booking-service",
        "Run notification-service",
        "Run api-gateway",
        "Run frontend"
      ],
      "problemMatcher": []
    },
    {
      "label": "Start Full App",
      "detail": "Build the backend, then start all 6 services and the React frontend (http://localhost:5173)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build backend",
        "Run all services"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run backend tests",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\test-backend.ps1"
      ],
      "linux": {
        "command": "mvn",
        "args": [
          "-f",
          "backend/pom.xml",
          "-B",
          "-ntp",
          "test"
        ]
      },
      "osx": {
        "command": "mvn",
        "args": [
          "-f",
          "backend/pom.xml",
          "-B",
          "-ntp",
          "test"
        ]
      },
      "group": "test",
      "problemMatcher": []
    },
    {
